{
  "$defs": {
    "Access": {
      "additionalProperties": false,
      "description": "Who may call the agent: IAM bindings on the reasoning engine itself, not the project.",
      "properties": {
        "invokers": {
          "description": "IAM members granted `role` on the engine (user:, group:, \u2026).",
          "items": {
            "type": "string"
          },
          "title": "Invokers",
          "type": "array"
        },
        "role": {
          "default": "roles/aiplatform.user",
          "description": "Role granted on the engine. For least privilege, use a custom role that holds only aiplatform.reasoningEngines.query, e.g. projects/<project>/roles/agentInvoker.",
          "title": "Role",
          "type": "string"
        }
      },
      "title": "Access",
      "type": "object"
    },
    "Agent": {
      "additionalProperties": false,
      "description": "The deployed agent itself.",
      "properties": {
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "framework": {
          "default": "google-adk",
          "title": "Framework",
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "$ref": "#/$defs/SecretRef"
          },
          "title": "Secrets",
          "type": "object"
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Telemetry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deprecated: use observability.tracing."
        },
        "encryption": {
          "$ref": "#/$defs/Encryption"
        }
      },
      "title": "Agent",
      "type": "object"
    },
    "AgentRegistry": {
      "additionalProperties": false,
      "description": "Registration of the agent's A2A card as a service in the Agent Registry.",
      "properties": {
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registry location; defaults to provider.region.",
          "title": "Location"
        },
        "serviceId": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to <service>-<stage>.",
          "title": "Serviceid"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the card's name.",
          "title": "Displayname"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the card's description.",
          "title": "Description"
        }
      },
      "title": "AgentRegistry",
      "type": "object"
    },
    "Authorization": {
      "additionalProperties": false,
      "description": "OAuth authorization used by Gemini Enterprise to call the agent on the user's behalf.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shown on the consent prompt; defaults to the id.",
          "title": "Displayname"
        },
        "clientId": {
          "title": "Clientid",
          "type": "string"
        },
        "clientSecret": {
          "title": "Clientsecret",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "authorizationUri": {
          "default": "https://accounts.google.com/o/oauth2/v2/auth",
          "title": "Authorizationuri",
          "type": "string"
        },
        "tokenUri": {
          "default": "https://oauth2.googleapis.com/token",
          "title": "Tokenuri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "clientId",
        "clientSecret",
        "scopes"
      ],
      "title": "Authorization",
      "type": "object"
    },
    "Bucket": {
      "additionalProperties": false,
      "description": "A GCS bucket agentless creates and owns, with access granted to the agent's runtime identity.",
      "properties": {
        "name": {
          "description": "Globally unique bucket name, e.g. acme-reports-${stage}.",
          "title": "Name",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Region or multi-region; defaults to provider.region.",
          "title": "Location"
        },
        "storageClass": {
          "default": "STANDARD",
          "enum": [
            "STANDARD",
            "NEARLINE",
            "COLDLINE",
            "ARCHIVE"
          ],
          "title": "Storageclass",
          "type": "string"
        },
        "versioning": {
          "default": false,
          "title": "Versioning",
          "type": "boolean"
        },
        "lifecycle": {
          "$ref": "#/$defs/BucketLifecycle"
        },
        "kmsKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CMEK for objects. The Cloud Storage service agent needs encrypter/decrypter on the key.",
          "title": "Kmskey"
        },
        "access": {
          "default": "objectUser",
          "description": "Role granted to the runtime identity on this bucket.",
          "enum": [
            "objectViewer",
            "objectUser",
            "objectAdmin",
            "none"
          ],
          "title": "Access",
          "type": "string"
        },
        "env": {
          "anyOf": [
            {
              "pattern": "^[A-Z_][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Env var that receives the bucket name.",
          "title": "Env"
        },
        "deletionPolicy": {
          "default": "retain",
          "description": "On `remove` or when dropped from agent.yaml: retain keeps the bucket and its data; delete removes it only if it is empty. Objects are never deleted.",
          "enum": [
            "retain",
            "delete"
          ],
          "title": "Deletionpolicy",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Bucket",
      "type": "object"
    },
    "BucketLifecycle": {
      "additionalProperties": false,
      "description": "Object lifecycle; agentless owns the bucket's lifecycle rules once this is set, and leaves them alone otherwise.",
      "properties": {
        "deleteAfterDays": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delete objects older than this.",
          "title": "Deleteafterdays"
        }
      },
      "title": "BucketLifecycle",
      "type": "object"
    },
    "Build": {
      "additionalProperties": false,
      "description": "Container build settings (sourceCodeSpec.imageSpec).",
      "properties": {
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Args",
          "type": "object"
        }
      },
      "title": "Build",
      "type": "object"
    },
    "CloudRun": {
      "additionalProperties": false,
      "description": "Cloud Run service settings (provider.name: cloud-run); callers need roles/run.invoker unless auth: webhook.",
      "properties": {
        "serviceName": {
          "anyOf": [
            {
              "pattern": "^[a-z]([a-z0-9-]{0,47}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to <service>-<stage>.",
          "title": "Servicename"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prebuilt image (e.g. built in CI). When set, agentless does not build the source.",
          "title": "Image"
        },
        "artifactRegistry": {
          "default": "cloud-run-source-deploy",
          "description": "Docker repository in provider.region that receives built images; it must already exist.",
          "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Artifactregistry",
          "type": "string"
        },
        "buildServiceAccount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Service account Cloud Build runs as; defaults to the project's build default.",
          "title": "Buildserviceaccount"
        },
        "ingress": {
          "default": "all",
          "description": "Network sources allowed to reach the service. IAM still applies to every request.",
          "enum": [
            "all",
            "internal",
            "internal-and-cloud-load-balancing"
          ],
          "title": "Ingress",
          "type": "string"
        },
        "iap": {
          "default": false,
          "description": "Put Identity-Aware Proxy in front of the service.",
          "title": "Iap",
          "type": "boolean"
        },
        "auth": {
          "default": "iam",
          "description": "iam: Cloud Run checks the caller's ID token (Authorization). googleToken: Cloud Run still checks it, sent as X-Serverless-Authorization, and the container also verifies the Google token in googleToken.header. webhook: for callers that cannot get a Google token (GitLab, GitHub webhooks): Cloud Run's invoker IAM check is off and the container must reject every request without the secret in webhook.header; agentless checks that it does after each rollout and turns IAM back on if not.",
          "enum": [
            "iam",
            "googleToken",
            "webhook"
          ],
          "title": "Auth",
          "type": "string"
        },
        "googleToken": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoogleToken"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Settings of auth: googleToken."
        },
        "webhook": {
          "anyOf": [
            {
              "$ref": "#/$defs/Webhook"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Settings of auth: webhook."
        },
        "vpcEgress": {
          "anyOf": [
            {
              "$ref": "#/$defs/VpcEgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout": {
          "default": "300s",
          "description": "Request timeout, at most 3600s.",
          "pattern": "^\\d+s$",
          "title": "Timeout",
          "type": "string"
        },
        "cpuThrottling": {
          "default": false,
          "description": "Only allocate CPU during requests.",
          "title": "Cputhrottling",
          "type": "boolean"
        },
        "sessionAffinity": {
          "default": true,
          "title": "Sessionaffinity",
          "type": "boolean"
        },
        "port": {
          "default": 8080,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "CloudRun",
      "type": "object"
    },
    "DeployerConfig": {
      "additionalProperties": false,
      "description": "Service account agentless impersonates for every GCP call (needs roles/iam.serviceAccountTokenCreator).",
      "properties": {
        "impersonate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deployer service account email. Overridden by --impersonate-service-account and AGENTLESS_IMPERSONATE_SERVICE_ACCOUNT. Cannot use ${secret:} or ${tf:}.",
          "title": "Impersonate"
        },
        "delegates": {
          "description": "Delegation chain, in order, when the caller cannot impersonate directly.",
          "items": {
            "type": "string"
          },
          "title": "Delegates",
          "type": "array"
        }
      },
      "title": "DeployerConfig",
      "type": "object"
    },
    "DnsPeering": {
      "additionalProperties": false,
      "description": "DNS peering for PSC-I.",
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "targetProject": {
          "title": "Targetproject",
          "type": "string"
        },
        "targetNetwork": {
          "title": "Targetnetwork",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "targetProject",
        "targetNetwork"
      ],
      "title": "DnsPeering",
      "type": "object"
    },
    "Encryption": {
      "additionalProperties": false,
      "description": "Customer-managed encryption key.",
      "properties": {
        "kmsKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kmskey"
        }
      },
      "title": "Encryption",
      "type": "object"
    },
    "EvalMonitor": {
      "additionalProperties": false,
      "description": "An online monitor: samples the deployed agent's traces and scores them about every 10 minutes.",
      "properties": {
        "metrics": {
          "description": "Predefined metrics, e.g. safety, final_response_quality, tool_use_quality (latest version) or a versioned spec name such as safety_v1.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "samplingPercent": {
          "default": 10,
          "description": "Share of traces to score.",
          "maximum": 100,
          "minimum": 1,
          "title": "Samplingpercent",
          "type": "integer"
        },
        "maxSamplesPerRun": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost cap per evaluation run.",
          "title": "Maxsamplesperrun"
        },
        "filter": {
          "$ref": "#/$defs/MonitorFilter"
        },
        "enabled": {
          "default": true,
          "description": "false suspends the monitor and keeps its configuration.",
          "title": "Enabled",
          "type": "boolean"
        },
        "displayName": {
          "anyOf": [
            {
              "maxLength": 63,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to <service>-<stage>-<key>.",
          "title": "Displayname"
        }
      },
      "required": [
        "metrics"
      ],
      "title": "EvalMonitor",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "description": "Evaluation of the deployed agent: on demand (`agentless eval`), after deploy, and online monitors.",
      "properties": {
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "agents-cli EvaluationDataset (JSON with eval_cases), relative to agent.yaml.",
          "title": "Dataset"
        },
        "dest": {
          "anyOf": [
            {
              "pattern": "^gs://[^/]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GCS prefix for evaluation results. Defaults to gs://<stagingBucket>/agentless/<service>/<stage>/evals when provider.stagingBucket is set.",
          "title": "Dest"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Metric name \u2192 minimum average score (0 to 1); null reports the metric without gating on it.",
          "title": "Metrics",
          "type": "object"
        },
        "afterDeploy": {
          "default": false,
          "description": "Run the evaluation at the end of `deploy` and fail when a threshold is missed.",
          "title": "Afterdeploy",
          "type": "boolean"
        },
        "monitors": {
          "additionalProperties": {
            "$ref": "#/$defs/EvalMonitor"
          },
          "title": "Monitors",
          "type": "object"
        }
      },
      "title": "Evaluation",
      "type": "object"
    },
    "GeminiEnterprise": {
      "additionalProperties": false,
      "description": "Gemini Enterprise registration.",
      "properties": {
        "app": {
          "pattern": "^projects/[^/]+/locations/[^/]+/collections/[^/]+/engines/[^/]+$",
          "title": "App",
          "type": "string"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "toolDescription": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tooldescription"
        },
        "registration": {
          "default": "adk",
          "description": "adk: Gemini Enterprise calls the engine natively (recommended on Agent Runtime). a2a: registers the agent card; the agent must be an A2A agent.",
          "enum": [
            "adk",
            "a2a"
          ],
          "title": "Registration",
          "type": "string"
        },
        "sharing": {
          "anyOf": [
            {
              "enum": [
                "allUsers",
                "restricted",
                "private"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "allUsers: everyone in the app. restricted: the users and groups given access in the console (User permissions). private: only the creator and admins. Omit to leave the app's setting alone.",
          "title": "Sharing"
        },
        "agentGateway": {
          "anyOf": [
            {
              "pattern": "^projects/[^/]+/locations/[^/]+/agentGateways/[^/]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Egress Agent Gateway of the app. Set when the app has none; never changed or reverted, since every agent of the app shares it.",
          "title": "Agentgateway"
        },
        "grantServiceAgent": {
          "default": true,
          "description": "Grant access.role on the engine to the app's Discovery Engine service agent, so the app can call the agent.",
          "title": "Grantserviceagent",
          "type": "boolean"
        },
        "authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Authorization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "app"
      ],
      "title": "GeminiEnterprise",
      "type": "object"
    },
    "GoogleToken": {
      "additionalProperties": false,
      "description": "Second check of `cloudRun.auth: googleToken`, done by the container: agentless only passes these settings.",
      "properties": {
        "header": {
          "default": "x-google-token",
          "description": "Request header carrying the caller's Google ID token for the app to verify.",
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Header",
          "type": "string"
        },
        "audiences": {
          "description": "Accepted `aud` values of that token; defaults to the service URL.",
          "items": {
            "type": "string"
          },
          "title": "Audiences",
          "type": "array"
        },
        "allowedPrincipals": {
          "description": "Who the container accepts: emails (users or service accounts) or domain:<domain>.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowedprincipals",
          "type": "array"
        }
      },
      "required": [
        "allowedPrincipals"
      ],
      "title": "GoogleToken",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "description": "Who the agent runs as and what it may access.",
      "properties": {
        "type": {
          "$ref": "#/$defs/IdentityType",
          "default": "serviceAccount"
        },
        "serviceAccount": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceAccount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "roles": {
          "$ref": "#/$defs/Roles"
        }
      },
      "title": "Identity",
      "type": "object"
    },
    "IdentityType": {
      "description": "Runtime identity of the agent.",
      "enum": [
        "platform",
        "serviceAccount",
        "agentIdentity"
      ],
      "title": "IdentityType",
      "type": "string"
    },
    "Memory": {
      "additionalProperties": false,
      "description": "Sessions and long-term memory.",
      "properties": {
        "sessions": {
          "default": "agentPlatform",
          "enum": [
            "agentPlatform",
            "inMemory"
          ],
          "title": "Sessions",
          "type": "string"
        },
        "artifactsBucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GCS bucket for ADK artifacts (LOGS_BUCKET_NAME).",
          "title": "Artifactsbucket"
        },
        "memoryBank": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryBank"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Memory",
      "type": "object"
    },
    "MemoryBank": {
      "additionalProperties": false,
      "description": "Memory Bank (contextSpec.memoryBankConfig).",
      "properties": {
        "generationModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generationmodel"
        },
        "embeddingModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embeddingmodel"
        },
        "ttl": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?s$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl"
        },
        "topics": {
          "description": "Managed memory topics, e.g. USER_PREFERENCES.",
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "disableMemoryRevisions": {
          "anyOf": [
            {
              "type": "boolean"
            },
